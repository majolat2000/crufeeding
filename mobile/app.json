{
  "expo": {
    "name": "Crawford Feeding",
    "slug": "crawford-feeding",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "crawford-feeding",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A153B",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.majolat2000.crawfordfeeding",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.majolat2000.crawfordfeeding",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A153B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "000dbe92-926b-4680-89c9-bc825251a904"
      }
    },
    "owner": "majolat2000"
  }
}
