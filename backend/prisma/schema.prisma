// PostgreSQL single source of truth — replaces Mongo during levy sunset
// Run: npx prisma migrate dev --name init && npx prisma generate
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  subscriber
  bursar
  super_admin
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  matricNo     String?  @unique // CRU******* or 2********; null for Visitor
  // Visitor: only email+password, level= Visitor
  role         Role     @default(user)
  // JUPEB, 100 LEVEL, 200 LEVEL, 300 LEVEL, 500 LEVEL, Visitor
  level        String?
  isVisitor    Boolean  @default(false)
  // Subscriber plan tickers
  mealBreakfast Boolean @default(false)
  mealLunch     Boolean @default(false)
  mealDinner    Boolean @default(false)
  // Legacy hostel kept nullable but not used
  hostel       String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       Wallet?
  activityLogs ActivityLog[]
}

model Wallet {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  balance   Decimal @db.Decimal(12,2) // kobo precision
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id        String @id @default(cuid())
  name      String @unique
  icon      String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
}

model Hostel {
  id        String @id @default(cuid())
  name      String @unique
  capacity  Int
  occupants Int @default(0)
  status    String @default("Active")
  createdAt DateTime @default(now())
}

model Level {
  id        String @id @default(cuid())
  name      String @unique // "100 Level"
  cap       Decimal @db.Decimal(12,2)
  plan      String
  createdAt DateTime @default(now())
}

model GlobalConfig {
  id             String   @id @default(cuid())
  // Granular daily rates — Fund Valid Students calculates: days * rate
  breakfastRate  Decimal  @db.Decimal(12,2) @default(1500)
  lunchRate      Decimal  @db.Decimal(12,2) @default(2000)
  dinnerRate     Decimal  @db.Decimal(12,2) @default(1500)
  allThreeRate   Decimal  @db.Decimal(12,2) @default(5000)
  // legacy single amount kept for migration
  feedingAmount  Decimal? @db.Decimal(12,2)
  session        String?  @default("2026/2027")
  updatedBy      String?
  updatedAt      DateTime @updatedAt
}

model Transaction {
  id           String   @id @default(cuid())
  studentId    String
  vendorId     String
  vendorName   String?
  type         String   // credit / debit
  gross        Decimal  @db.Decimal(12,2) // 100% to vendor
  // levy sunset — kept nullable for migration, always 0 going forward
  levy         Decimal? @db.Decimal(12,2) @default(0)
  vendorPayout Decimal  @db.Decimal(12,2)
  balanceAfter Decimal  @db.Decimal(12,2)
  status       String   @default("success")
  hostel       String?
  level        String?
  createdAt    DateTime @default(now())
  @@index([studentId])
  @@index([vendorId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actorEmail String
  action    String   // e.g. FUND_VALID_STUDENTS, UPDATE_FEEDING_AMOUNT
  target    String?
  hostel    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [actorId], references: [id])
  @@index([createdAt])
}
