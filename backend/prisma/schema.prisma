generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  subscriber
  bursar
  super_admin
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String   @default("")
  matricNo      String?  @unique
  fullname      String?
  role          Role     @default(user)
  level         String?
  isVisitor     Boolean  @default(false)
  mealBreakfast Boolean  @default(false)
  mealLunch     Boolean  @default(false)
  mealDinner    Boolean  @default(false)
  hostel        String?
  pin           String?
  biometricEnabled Boolean @default(false)
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wallet        Wallet?
  activityLogs  ActivityLog[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @db.Decimal(12,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Hostel {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int
  occupants Int      @default(0)
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  cap       Decimal  @db.Decimal(12,2)
  plan      String
  createdAt DateTime @default(now())
}

model GlobalConfig {
  id            String   @id @default(cuid())
  breakfastRate Decimal  @db.Decimal(12,2) @default(1500)
  lunchRate     Decimal  @db.Decimal(12,2) @default(2000)
  dinnerRate    Decimal  @db.Decimal(12,2) @default(1500)
  allThreeRate  Decimal  @db.Decimal(12,2) @default(5000)
  feedingAmount Decimal? @db.Decimal(12,2)
  session       String?  @default("2025/2026")
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id           String   @id @default(cuid())
  studentId    String
  vendorId     String
  vendorName   String?
  type         String
  gross        Decimal  @db.Decimal(12,2)
  levy         Decimal? @db.Decimal(12,2) @default(0)
  vendorPayout Decimal  @db.Decimal(12,2)
  balanceAfter Decimal  @db.Decimal(12,2)
  status       String   @default("success")
  reference    String?
  hostel       String?
  level        String?
  createdAt    DateTime @default(now())
  @@index([studentId])
  @@index([vendorId])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  target     String?
  hostel     String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [actorId], references: [id])
  @@index([createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  purpose   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([email, purpose])
}
